
import { useEffect, useState } from "react";

export default function CryptoNews({ activeTab, theme, panel }) {
  const [news, setNews] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  useEffect(() => {
    if (activeTab !== "news") return;

    const controller = new AbortController();

    async function fetchNews() {
      setLoading(true);
      setError("");

      try {
        const response = await fetch(
          "https://min-api.cryptocompare.com/data/v2/news/?lang=EN",
          { signal: controller.signal }
        );

        if (!response.ok) {
          throw new Error("Serivisi y'amakuru ntiboneka ubu.");
        }

        const result = await response.json();

        if (result.Response === "Error" || !Array.isArray(result.Data)) {
          throw new Error("Ntabwo tubashije kubona amakuru.");
        }

        setNews(result.Data);
      } catch (err) {
        if (err.name !== "AbortError") {
          setError(err.message || "Habaye ikibazo mu kubona amakuru.");
        }
      } finally {
        if (!controller.signal.aborted) setLoading(false);
      }
    }

    fetchNews();

    return () => controller.abort();
  }, [activeTab]);

  if (activeTab !== "news") return null;

  return (
    <section style={{ marginBottom: 22 }}>
      <h2 style={{ marginTop: 0 }}>📰 Crypto News</h2>
      <p style={{ color: theme.muted, fontSize: 13 }}>
        Amakuru agezweho ku isoko rya cryptocurrency.
      </p>

      {loading && <div style={panel}>Turimo gushaka amakuru...</div>}

      {error && (
        <div style={{ ...panel, border: "1px solid #ef4444" }}>
          <p>{error}</p>
          <button onClick={() => window.location.reload()}>
            Ongera ugerageze
          </button>
        </div>
      )}

      {!loading && !error && news.length === 0 && (
        <div style={panel}>Nta makuru ahari muri aka kanya.</div>
      )}

      <div
        style={{
          display: "grid",
          gridTemplateColumns: "repeat(auto-fit, minmax(min(100%, 280px), 1fr))",
          gap: 16,
        }}
      >
        {news.map((item) => (
          <article
            key={item.id || item.url}
            style={{
              ...panel,
              overflow: "hidden",
              minWidth: 0,
            }}
          >
            {item.image && (
              <img
                src={item.image}
                alt=""
                loading="lazy"
                style={{
                  width: "100%",
                  maxHeight: 190,
                  objectFit: "cover",
                  borderRadius: 8,
                }}
              />
            )}

            <p style={{ color: theme.muted, fontSize: 12 }}>
              {item.source || "Crypto News"}
            </p>

            <h3 style={{ fontSize: 17, lineHeight: 1.5 }}>
              {item.title}
            </h3>

            <p style={{ color: theme.muted, fontSize: 13, lineHeight: 1.7 }}>
              {item.body
                ? item.body.slice(0, 180) + "..."
                : "Fungura inkuru usome ibisobanuro birambuye."}
            </p>

            <a
              href={item.url}
              target="_blank"
              rel="noopener noreferrer"
              style={{
                color: "#06b6d4",
                textDecoration: "none",
                fontWeight: 600,
              }}
            >
              Soma inkuru yose ↗
            </a>
          </article>
        ))}
      </div>
    </section>
  );
}
